{
  "name": "saint-bypass-bot",
  "version": "2.0.0",
  "private": true,
  "description": "Modular WhatsApp automation and group administration bot foundation",
  "main": "legacy/index.js",
  "scripts": {
    "start": "node legacy/index.js",
    "start:legacy": "node legacy/index.js",
    "postinstall": "npm install --prefix legacy --omit=dev",
    "check": "node --check legacy/index.js",
    "test": "npm run test:jest && npm run test:node",
    "test:jest": "jest --runInBand --coverage",
    "test:node": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jest": "^30.5.1"
  }
}
